# Compose environment. Keep this file private and create it from
# .env.example; this tracked example contains no usable secrets.

# The external VPN container and its stable DNS alias on the existing `web`
# network. Verify both before starting Compose. Preserve the VPN kill-switch.
VPN_CONTAINER_NAME=gluetun
GLUETUN_ALIAS=gluetun
# Keep both trust settings blank until deployed Cloudflare edge ranges,
# origin protection, and the Caddy-side Docker subnet have been verified.
CADDY_TRUSTED_PROXY_CONFIG=
JUKES_TRUSTED_PROXY_CIDRS=

# Public address served by Caddy and used when the API returns audio URLs.
SITE_ADDRESS=your-hostname.example
PUBLIC_BASE_URL=https://your-hostname.example

# New persistent JUKES store. The old /data/data.db remains on ytmusic_data and
# is left untouched. Audio keeps using the existing cache volume.
JUKES_DB_PATH=/data/jukes.sqlite3
JUKES_AUDIO_DIR=/tmp/ytm_audio_cache
JUKES_REQUESTED_CACHE_LIMIT_BYTES=10000000000
JUKES_WARMUP_CACHE_LIMIT_BYTES=1000000000
JUKES_WARMUP_TTL_SECONDS=7200
JUKES_MIN_FREE_DISK_BYTES=2000000000

# Generate a password hash with the application setup instructions. Generate
# the two keys once, store them securely, and keep them stable across restarts.
# The credential encryption key is a Fernet key.
JUKES_ADMIN_PASSWORD_HASH=
JUKES_ADMIN_SESSION_KEY=
JUKES_CREDENTIAL_ENCRYPTION_KEY=

# Required, identical secret for Flask-to-browser control calls. Example:
# openssl rand -hex 32
YT_BROWSER_CONTROL_TOKEN=
YT_BROWSER_SERVICE_URL=http://127.0.0.1:8765
YT_BROWSER_CAPTURE_TIMEOUT=120
YT_BROWSER_LOGIN_TIMEOUT=240
YT_BROWSER_SUCCESS_DISPLAY=12
YT_BROWSER_SCREEN_GEOMETRY=1365x768x24

# The external bgutil-provider must share the `web` network and resolve from
# the VPN namespace. Deno remains yt-dlp's JavaScript runtime.
YTDLP_BGUTIL_BASE_URL=http://bgutil-provider:4416
YTDLP_JS_RUNTIME=deno
# Optional: yt-dlp client order, comma-separated. Default: tv_simply first (needs the
# bgutil PO token; ~3 s per song), then web_embedded (pre-roll ad wait, ~10 s), then the
# legacy fallbacks. To roll back: YTDLP_CLIENT_ORDER=web_embedded,default,android_vr,web,tv
# YTDLP_CLIENT_ORDER=

# --- Optional bundled Gluetun (docker-compose.vpn.yml) ---------------------
# Only used with: docker compose -f docker-compose.yml -f docker-compose.vpn.yml up -d
# Put your Surfshark India profile in ./vpn (see vpn/README.md). Never commit it.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
# WireGuard profile file in ./vpn/wireguard (without .conf): in-mum, in-del, ...
VPN_PROFILE=in-mum
# Country scripts/verify-vpn.sh expects as the exit (India).
EXPECTED_COUNTRY=IN
# Only for the built-in 'surfshark' provider; leave empty with a custom profile file.
VPN_NATIVE_SERVER_COUNTRIES=
OPENVPN_CUSTOM_CONFIG=/gluetun/openvpn/surfshark.ovpn
OPENVPN_USER=
OPENVPN_PASSWORD=
# Subnet of the external `web` network (docker network inspect web) so Gluetun's
# firewall lets the app reach bgutil-provider.
DOCKER_WEB_SUBNET=172.18.0.0/16
# Loopback-only direct API access for smoke tests; public traffic uses Caddy.
JUKES_DIRECT_BIND=127.0.0.1:5000

# --- Cloudflare Quick Tunnel overlay (docker-compose.tunnel.yml) -----------
# Nothing to set: PUBLIC_BASE_URL is derived from the tunnel. Reuses DOCKER_WEB_SUBNET.

# --- Saved-session auto-refresh (rare, irregular, need-driven) ---------------
# 1 = on (default). Reuses the signed-in browser profile; no password is ever stored.
# Only runs when cookies near expiry or cookie-specific download failures repeat.
JUKES_COOKIE_AUTOREFRESH=1
# Optional extra, jittered upkeep every ~N days (0 = off, recommended).
JUKES_COOKIE_MAINTENANCE_DAYS=0

# --- Named Cloudflare Tunnel (docker-compose.tunnel-named.yml) ---------------
# Token from Zero Trust > Networks > Tunnels. Treat as a secret; set it with:
#   read -rs -p 'Tunnel token: ' T; echo "CLOUDFLARE_TUNNEL_TOKEN=$T" >> .env; unset T
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: pin the public URL (otherwise derived from the tunnel's forwarded host).
JUKES_PUBLIC_URL=
