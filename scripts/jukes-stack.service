[Unit]
Description=JUKES serving stack (VPN, backend, resolver, tunnel)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# install-host.sh replaces __DIR__ with the checkout path
ExecStart=__DIR__/scripts/start-stack.sh
TimeoutStartSec=400

[Install]
WantedBy=multi-user.target
