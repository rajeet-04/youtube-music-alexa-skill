[Unit]
Description=Attach bgutil-provider to the web Docker network (PO token sidecar for ytmusic)
After=docker.service
Requires=docker.service
# The provider and shared web network are managed outside this repository and
# may be created after Docker starts. The helper exits with EX_TEMPFAIL until
# both exist, and systemd retries without a start-limit lockout.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/home/ubuntu/youtube-music-alexa-skill/scripts/ensure-bgutil-network.sh
RemainAfterExit=no
Restart=on-failure
RestartSec=30s
TimeoutStartSec=30s
User=ubuntu

[Install]
WantedBy=multi-user.target
