# Optional complete global options block. Keep blank until the deployed
# Cloudflare source ranges and origin protection have been verified.
{$CADDY_TRUSTED_PROXY_CONFIG}

{$SITE_ADDRESS:localhost} {
    handle_path /youtube-login/* {
        forward_auth {$GLUETUN_ALIAS:gluetun}:5000 {
            uri /admin/youtube/browser/authorize
            # The backend receives Caddy's resolved peer/client identity, not
            # caller-supplied Cloudflare or forwarding headers.
            header_up X-Forwarded-For {client_ip}
            header_up X-Real-IP {client_ip}
            header_up -CF-Connecting-IP
            header_up -True-Client-IP
            # A WebSocket request is cloned for this ordinary HTTP auth
            # check. Strip upgrade headers from the clone only; the original
            # request keeps them for the noVNC reverse proxy below.
            header_up -Connection
            header_up -Upgrade
        }
        header Cache-Control "no-store"
        reverse_proxy {$GLUETUN_ALIAS:gluetun}:6080
    }
    handle {
        reverse_proxy {$GLUETUN_ALIAS:gluetun}:5000 {
            # Overwrite caller-supplied IP claims with Caddy's computed
            # identity. With no trusted edge config, this is the direct peer.
            header_up X-Forwarded-For {client_ip}
            header_up X-Real-IP {client_ip}
            header_up -CF-Connecting-IP
            header_up -True-Client-IP
        }
    }
}
